# Playtest 3: the autodoc's own atmosphere. The readout beside the status, and the examine line for the seal.

wolfmed-autodoc-seal-open = LID OPEN
wolfmed-autodoc-seal-sealed = SEALED
wolfmed-autodoc-seal-unpowered = UNSEALED: NO POWER
wolfmed-autodoc-seal-breached = HULL BREACH: OUTSIDE ATMOSPHERE
wolfmed-autodoc-seal-vented = UNSEALED: VENTING

wolfmed-autodoc-examine-seal-sealed = The seals are shut. The patient is breathing the pod's own air.
wolfmed-autodoc-examine-seal-unpowered = The seals hang slack with no power. The patient is breathing the room's air.
wolfmed-autodoc-examine-seal-breached = [color=red]The hull is breached[/color] and outside air gets in. A welder would close it.
wolfmed-autodoc-examine-seal-vented = Its vents stand open. The patient is breathing the room's air.
