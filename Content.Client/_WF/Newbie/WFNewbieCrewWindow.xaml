<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'wf-newbie-crew-title'}"
                      MinSize="400 160">
    <!-- A set width, so the text wraps. -->
    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="12" SetWidth="420">
        <RichTextLabel Name="CrewLabel" />
        <BoxContainer Orientation="Horizontal">
            <Control HorizontalExpand="True" />
            <Button Name="OkButton" Text="{Loc 'wf-newbie-crew-ok'}" MinWidth="80" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
