# Anatomy admin verbs (GenitalAdminVerbSystem). Admins see the anatomy verbs only with their own Adult content on.

wf-anatomy-admin-verb-reapply = Anatomy: reapply profile
wf-anatomy-admin-verb-reapply-message = Rebuild this body's anatomy from its player's selected character profile.
wf-anatomy-admin-verb-clear = Anatomy: clear runtime state
wf-anatomy-admin-verb-clear-message = Reset arousal, undergarments, reveal mode and visibility to the profile defaults.
wf-anatomy-admin-verb-dump = Anatomy: dump
wf-anatomy-admin-verb-dump-message = Send yourself a private summary of this body's anatomy.
wf-anatomy-admin-verb-locked = Anatomy tools (enable Adult content to use)
wf-anatomy-admin-verb-locked-message = Turn on Adult content in your consent settings to use the anatomy tools.

# Replies, sent to the acting admin only.
wf-anatomy-admin-reapplied = Anatomy profile reapplied to { $target }.
wf-anatomy-admin-reapplied-pending = Anatomy profile stored for { $target }. Organs are built once anatomy is enabled and its player has Adult content on.
wf-anatomy-admin-no-profile = { $target } has no connected player with a character profile.
wf-anatomy-admin-ineligible = { $target } is no longer eligible for anatomy, so it was removed.
wf-anatomy-admin-cleared = Anatomy runtime state of { $target } reset to the profile defaults.

# Summary lines ("Anatomy: dump").
wf-anatomy-admin-dump-header = Anatomy summary for { $target }:
wf-anatomy-admin-dump-body = Species { $species }, age { $age }, eligible: { $eligible }
wf-anatomy-admin-dump-penis = Penis: { $shape }, { $length } cm (size { $step }), sheath: { $sheath }, colour { $colour }
wf-anatomy-admin-dump-testicles = Testicles: { $type }, size { $step }, colour { $colour }
wf-anatomy-admin-dump-vagina = Vagina: { $shape }, colour { $colour }
wf-anatomy-admin-dump-womb = Womb: present
wf-anatomy-admin-dump-breasts = Breasts: { $shape }, cup size { $cup }, lactation: { $lactation }, colour { $colour }
wf-anatomy-admin-dump-no-organs = No anatomy organs.
wf-anatomy-admin-dump-runtime = Arousal { $arousal } ({ $state }), reveal mode: { $reveal }, undergarments removed: { $undergarments }, strip cooldown { $cooldown } s
wf-anatomy-admin-dump-visibility = Visibility: penis { $penis }, testicles { $testicles }, vagina { $vagina }, breasts { $breasts }
wf-anatomy-admin-dump-template = Profile template: { $template }; organs built: { $built }; mirror filled: { $mirror }
wf-anatomy-admin-dump-consent = Consent: Adult content { $master }, undergarment removal { $strip }, anatomy surgery { $surgery }; actively present: { $present }

wf-anatomy-admin-yes = yes
wf-anatomy-admin-no = no
wf-anatomy-admin-none = none
wf-anatomy-admin-template-unset = not set
