<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'remnant-lock-ui-title'}"
               MinSize="220 260"
               SetSize="220 260">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="6">
        <Label Name="StatusLabel" HorizontalAlignment="Center" Margin="0 0 0 6"/>
        <Label Name="CodeLabel" HorizontalAlignment="Center" Align="Center" Margin="0 0 0 8"/>
        <GridContainer Columns="3" Name="KeypadGrid" HorizontalAlignment="Center"/>
    </BoxContainer>
</DefaultWindow>
