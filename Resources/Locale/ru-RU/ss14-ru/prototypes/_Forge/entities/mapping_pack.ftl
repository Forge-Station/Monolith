ent-WallXeno = стена чужих
    .desc = Затвердевший хитин, выросший в полноценную стену.
    .suffix = Forge, Ксено, Хитин
ent-WallXenoReinforced = укреплённая стена чужих
    .desc = Слои хитина, утрамбованные до прочности переборки.
    .suffix = Forge, Ксено, Хитин, Укреплённая
ent-WallXenoResin = смоляная стена
    .desc = Странная слизь, застывшая стеной.
    .suffix = Forge, Ксено, CM
ent-WallXenoResinThick = толстая смоляная стена
    .desc = Слизь, убитая в толстую упрямую стену.
    .suffix = Forge, Ксено, CM
ent-WallXenoMembrane = смоляная мембрана
    .desc = Полупрозрачная слизь, которая всё ещё держит атмосферу.
    .suffix = Forge, Ксено, CM
ent-WallXenoMembraneThick = толстая смоляная мембрана
    .desc = Толстая слизь, едва достаточно прозрачная, чтобы пропускать свет.
    .suffix = Forge, Ксено, CM
ent-WallXenoResinIndestructible = { ent-WallXenoResin }
    .desc = { ent-WallXenoResin.desc }
    .suffix = Forge, Ксено, CM, Неразрушимая

ent-DoorXenoResin = смоляная дверь
    .desc = Живой смоляной сфинктер. Лом его открывает, ксеноморф проходит сам.
    .suffix = Forge, Ксено, CM
ent-DoorXenoResinOpen = { ent-DoorXenoResin }
    .desc = { ent-DoorXenoResin.desc }
    .suffix = Forge, Ксено, CM, Открытая
ent-DoorXenoResinThick = толстая смоляная дверь
    .desc = Более толстый смоляной сфинктер. Лом всё равно его открывает, ксеноморф проходит сам.
    .suffix = Forge, Ксено, CM
ent-DoorXenoResinThickOpen = { ent-DoorXenoResinThick }
    .desc = { ent-DoorXenoResinThick.desc }
    .suffix = Forge, Ксено, CM, Открытая

ent-XenoRecoveryTower = башня восстановления ксено
    .desc = Пульсирующий смоляной шпиль. Улей сращивает им раны.
    .suffix = Forge, Ксено
ent-XenoFrenzyTower = башня бешенства ксено
    .desc = Зубчатый смоляной шпиль. Стоять рядом — плохая идея.
    .suffix = Forge, Ксено
ent-XenoHiveCore = ядро улья
    .desc = Сердце улья ксеноморфов. Ему здесь не место.
    .suffix = Forge, Ксено, CM
ent-XenoEggMorpher = яйцеморф
    .desc = Раздутый смоляной орган, растущий яйца для улья.
    .suffix = Forge, Ксено, CM
ent-XenoRecoveryNode = узел восстановления
    .desc = Смоляной узел, сочащийся целебной плазмой.
    .suffix = Forge, Ксено, CM
ent-XenoHivePylon = пилон улья
    .desc = Смоляной пилон, якорящий присутствие улья.
    .suffix = Forge, Ксено, CM
ent-XenoHiveCluster = кластер улья
    .desc = Плотный сгусток живой смолы.
    .suffix = Forge, Ксено, CM
ent-XenoPlasmaCollector = сборщик плазмы
    .desc = Смоляной орган, собирающий плазму с сорняков.
    .suffix = Forge, Ксено, CM
ent-XenoWeeds = сорняки улья
    .desc = Ковёр живой смолы. Липнет к ботинкам и стенам.
    .suffix = Forge, Ксено, CM
ent-XenoWeedsChoke = густые сорняки улья
    .desc = Душный ковёр смолы. Через него приходится прорываться. Ксеноморфы проходят.
    .suffix = Forge, Ксено, CM, Коридор
ent-XenoWeedNode = узел сорняков улья
    .desc = Раздутый узел, питающий сорняки по всему улью.
    .suffix = Forge, Ксено, CM
ent-XenoStickyResin = липкая смола
    .desc = Густая цепкая слизь. Идти через неё — мучение.
    .suffix = Forge, Ксено, CM
ent-XenoFastResin = быстрая смола
    .desc = Скользкая смола улья. Ксеноморфам понравится. Вам — нет.
    .suffix = Forge, Ксено, CM
ent-XenoResinSpikes = смоляные шипы
    .desc = Зазубренные смоляные колючки. Наступать — ошибка.
    .suffix = Forge, Ксено, CM
ent-XenoEgg = яйцо ксеноморфа
    .desc = Кожистое чужое яйцо. Кто-то внутри хочет наружу.
    .suffix = Forge, Ксено, CM
ent-XenoEggOpened = вскрытое яйцо ксеноморфа
    .desc = Яйцо уже вылупилось. Обитатель — уже чья-то проблема.
    .suffix = Forge, Ксено, CM, Открытое
ent-XenoTunnel = туннель ксеноморфов
    .desc = Дыра, прогрызенная сквозь смолу и палубу. Никуда не ведёт, пока маппер её не свяжет.
    .suffix = Forge, Ксено, CM

ent-WallNanolaminateSecret = наноламинатная стена
    .desc = Плотная стена из странного ламината. Шов спрятан — откроет только связанная кнопка.
    .suffix = Forge, Потайная, Кнопка
ent-WallNanolaminateSecretOpen = { ent-WallNanolaminateSecret }
    .desc = { ent-WallNanolaminateSecret.desc }
    .suffix = Forge, Потайная, Кнопка, Открытая

ent-BlastDoorAdmin = гермозатвор
    .desc = Неразрушимый гермозатвор. Порты device-link может привязать только администратор.
    .suffix = Forge, Админ, Неразрушимый
ent-BlastDoorAdminOpen = { ent-BlastDoorAdmin }
    .desc = { ent-BlastDoorAdmin.desc }
    .suffix = Forge, Админ, Неразрушимый, Открытый

ent-MobForerunnerBorg = киборг предтеч
    .desc = Ободранный корпус предтеч на остаточных директивах. Слабее живого тендера, но череп всё ещё продавит.
    .suffix = Forge, Предтеч, ИИ
ent-MobForerunnerBorgEngineer = инженерный киборг предтеч
    .desc = Древний инженерный корпус. Инструменты уже грубые, но стену он всё ещё разберёт.
    .suffix = Forge, Предтеч, ИИ, Инженер
ent-MobForerunnerBorgAssault = штурмовой киборг предтеч
    .desc = Ободранный штурмовой корпус. Пушка ещё стреляет. Едва.
    .suffix = Forge, Предтеч, ИИ, Штурмовой

ent-MobXenoCMLarva = личинка ксеноморфа
    .desc = Извивающийся грудной взрывник. Маленькая, быстрая и уже злая.
    .suffix = Forge, CM, AI
ent-MobXenoCMLesserDrone = малый дрон ксеноморфа
    .desc = Хилый рабочий улья. Когти на месте, и немного плазмы тоже.
    .suffix = Forge, CM, AI
ent-MobXenoCMDrone = дрон ксеноморфа
    .desc = Строитель улья. 500 здоровья, полный запас плазмы и набор смолы.
    .suffix = Forge, CM, AI
ent-MobXenoCMRunner = бегун ксеноморфа
    .desc = Одни ноги и зубы. Успеет сблизиться, пока вы ещё целитесь.
    .suffix = Forge, CM, AI
ent-MobXenoCMSentinel = часовой ксеноморфа
    .desc = Плевательная каста. Кислота, плевок и хвост.
    .suffix = Forge, CM, AI
ent-MobXenoCMSpitter = плеватель ксеноморфа
    .desc = Злее часового. Кислоты больше, и она хуже.
    .suffix = Forge, CM, AI
ent-MobXenoCMBoiler = кипятильник ксеноморфа
    .desc = Раздутая артиллерия. Медленный, живучий и полный кислоты.
    .suffix = Forge, CM, AI
ent-MobXenoCMWarrior = воин ксеноморфа
    .desc = Компактная убийственная каста. Удар, рывок, бросок.
    .suffix = Forge, CM, AI
ent-MobXenoCMLurker = скрытень ксеноморфа
    .desc = Каста охотников. Прячется — и вот он уже сверху.
    .suffix = Forge, CM, AI
ent-MobXenoCMDefender = защитник ксеноморфа
    .desc = Живой щит. Укрепление и гребень почти не пускают урон.
    .suffix = Forge, CM, AI
ent-MobXenoCMRavager = опустошитель ксеноморфа
    .desc = Берсерк-каста. Если доберётся — эксперимент окончен.
    .suffix = Forge, CM, AI
ent-MobXenoCMPraetorian = преторианец ксеноморфа
    .desc = Королевская стража. Кислота, плевок и визг, от которого падает комната.
    .suffix = Forge, CM, AI
ent-MobXenoCMCrusher = крушитель ксеноморфа
    .desc = Живой таран. Сначала таран, потом топот по тому, что осталось.
    .suffix = Forge, CM, AI
ent-MobXenoCMHivelord = повелитель улья
    .desc = Раздутый строитель. Больше плазмы, толще смола и постройки под стать.
    .suffix = Forge, CM, AI
ent-MobXenoCMCarrier = носильщик ксеноморфа
    .desc = Ходячая яйцекладовая. Логистика улья, с когтями.
    .suffix = Forge, CM, AI
ent-MobXenoCMBurrower = копатель ксеноморфа
    .desc = Каста землекопов. Сажает сорняки и смолу, потом уходит.
    .suffix = Forge, CM, AI
ent-MobXenoCMQueen = королева ксеноморфов
    .desc = Мать улья. Визг, кислота, постройки и потрошащий хвост.
    .suffix = Forge, CM, AI

