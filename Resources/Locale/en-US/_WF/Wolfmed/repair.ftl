# A repair tool (the welder, the nanite applicator, the wrench) on a chassis.
wolfmed-repair-nothing = Nothing on { THE($target) } needs { THE($tool) }.
# Playtest 5: a round or a fragment still in a breach refuses every repair, and a pass that closes nothing is the last.
wolfmed-repair-embedded = Something is still lodged in { THE($target) }. Pull it out before { THE($tool) } can close the breach.
wolfmed-repair-no-progress = { CAPITALIZE(THE($tool)) } closes nothing more on { THE($target) }.
wolfmed-repair-fuel = { CAPITALIZE(THE($tool)) } runs dry before { THE($target) } is repaired.
