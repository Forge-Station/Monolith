<PanelContainer xmlns="https://spacestation14.io"
                xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                HorizontalExpand="True"
                MaxWidth="590">
    <PanelContainer.PanelOverride>
        <gfx:StyleBoxFlat BorderThickness="3" BorderColor="#101010" BackgroundColor="#242424"/>
    </PanelContainer.PanelOverride>
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="False">
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True">
        <Label Name="VesselName"
            Access="Public"
            HorizontalExpand="True"
            HorizontalAlignment="Left"
            Margin="5 0 2 0" />
        <Label Name="Price"
            Access="Public"
            MinWidth="80"
            Align="Right"
            Margin="0 0 5 0"
            HorizontalAlignment="Right" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      Margin="5 4 5 4">
        <controls:ConfirmButton Name="Purchase"
            Access="Public"
            ToolTip=""
            Text="{Loc 'shipyard-console-purchase-available'}"
            ConfirmationText="{Loc 'shipyard-console-confirm-unassign'}"
            StyleClasses="ButtonSquare"
            MinWidth="130"
            MinHeight="32"
            HorizontalAlignment="Right" /> <!-- 130 px: approximate width of "Purchase"-->
        <Button Name="Guidebook"
            Access="Public"
            Text="{Loc 'shipyard-console-guidebook'}"
            StyleClasses="ButtonSquare"
            Margin="4 0 0 0"
            MinHeight="32"
            HorizontalAlignment="Right" /> <!-- Left margin only -->
        <Button Name="Preview"
                Access="Public"
                Text="{Loc 'shipyard-console-preview'}"
                StyleClasses="ButtonSquare"
                Margin="4 0 0 0"
                MinHeight="32"
                HorizontalAlignment="Right" />
    </BoxContainer>
        <PanelContainer>
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BorderThickness="3" BorderColor="#242424" BackgroundColor="#1a1b1c"/>
        </PanelContainer.PanelOverride>
            <RichTextLabel Name="VesselDescription"
                           Access="Public"
                           HorizontalExpand="True"
                           Margin="5 4 5 4"
                           Modulate="#999999"/>
        </PanelContainer>
    </BoxContainer>
</PanelContainer>
