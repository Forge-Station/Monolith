<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               MinSize="480 420"
               SetSize="520 460"
               Title="{Loc ore-disposal-filter-ui-title}">
    <BoxContainer Orientation="Vertical" Margin="5 5 5 5" SeparationOverride="10">
        <Label Text="{Loc ore-disposal-filter-ui-select}" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 5">
            <GridContainer HorizontalExpand="True" Columns="3" Margin="0 5 0 0">
                <Button Name="SelectAllButton" HorizontalExpand="True" MinHeight="32" Text="{Loc ore-disposal-filter-ui-select-all}" />
                <Button Name="DeselectAllButton" HorizontalExpand="True" MinHeight="32" Text="{Loc ore-disposal-filter-ui-deselect-all}" />
                <Control HorizontalExpand="True" />
            </GridContainer>
        </BoxContainer>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" MinHeight="280">
            <GridContainer HorizontalExpand="True" Name="OreContainer" Columns="3" Margin="0 5 0 0" />
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
