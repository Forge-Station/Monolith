<ui:HydroponicsConsoleWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client._Forge.Botany.HydroponicsConsole"
    SetSize="1000 620"
    MinSize="820 480"
    MouseFilter="Stop">

    <PanelContainer Name="Background" StyleClasses="PdaBackgroundRect"/>
    <PanelContainer Name="Border" StyleClasses="PdaBorderRect"/>

    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">

        <BoxContainer SetHeight="40" Margin="20 10 10 5" Orientation="Horizontal" HorizontalExpand="True">
            <Label Name="TitleLabel" StyleClasses="ConsoleHeadingBig" HorizontalExpand="True"/>
            <Label Name="TimeLabel" StyleClasses="ConsoleHeading" Margin="0 0 12 0"/>
            <TextureButton Name="CloseButton" StyleClasses="windowCloseButton" VerticalAlignment="Center"/>
        </BoxContainer>

        <Control Margin="15 0 15 0" RectClipContent="True" VerticalExpand="True" HorizontalExpand="True">
            <PanelContainer Name="ContentBorder" StyleClasses="PdaBackground"/>
            <Control Margin="3 3" Modulate="#FFFFFF">
                <PanelContainer Name="ContentBackground" StyleClasses="PdaContentBackground"/>

                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">

                    <BoxContainer Orientation="Horizontal" Margin="10 8 10 0">
                        <Label Name="SubtitleLabel" StyleClasses="ConsoleSubHeading"/>
                        <Label Name="StatusLabel" StyleClasses="ConsoleText"
                               HorizontalExpand="True" HorizontalAlignment="Right"/>
                    </BoxContainer>

                    <Label Name="AlertLabel" StyleClasses="ConsoleText" Margin="10 4 10 0"/>

                    <BoxContainer Name="ViewBar" Orientation="Horizontal" Margin="10 4 10 0"/>
                    <BoxContainer Name="FilterBar" Orientation="Horizontal" Margin="10 4 10 0"/>

                    <BoxContainer Name="JournalToolbar" Orientation="Horizontal" Visible="False" Margin="10 4 10 0">
                        <LineEdit Name="LineNameEdit" HorizontalExpand="True" MinHeight="26" Margin="0 0 8 0"/>
                    </BoxContainer>

                    <PanelContainer Name="MainDivider" StyleClasses="LowDivider" HorizontalExpand="True" Margin="10 6 10 6" SetHeight="2"/>

                    <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True" Margin="10 0 10 10">

                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="0 0 12 0">
                            <BoxContainer Orientation="Horizontal" Margin="0 0 0 5">
                                <Label Name="DetailHeader" StyleClasses="ConsoleSubHeading"/>
                            </BoxContainer>
                            <PanelContainer Name="DetailPanel" StyleClasses="AngleRect" VerticalExpand="True" HorizontalExpand="True">
                                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                                    <BoxContainer Name="DetailContainer"
                                                  Orientation="Vertical"
                                                  VerticalExpand="True"
                                                  HorizontalExpand="True"
                                                  Margin="10"/>
                                </ScrollContainer>
                            </PanelContainer>
                        </BoxContainer>

                        <BoxContainer Orientation="Vertical" MinWidth="280" MaxWidth="320" VerticalExpand="True">
                            <BoxContainer Orientation="Horizontal" Margin="0 0 0 5">
                                <Label Name="ListHeader" StyleClasses="ConsoleSubHeading"/>
                                <Label Name="ListCountLabel" StyleClasses="ConsoleText"
                                       HorizontalExpand="True" HorizontalAlignment="Right"/>
                            </BoxContainer>
                            <PanelContainer Name="ListPanel" StyleClasses="AngleRect" VerticalExpand="True" HorizontalExpand="True">
                                <ScrollContainer Name="ListScroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                                    <BoxContainer Name="ListContainer"
                                                  Orientation="Vertical"
                                                  VerticalExpand="True"
                                                  HorizontalExpand="True"
                                                  Margin="6"/>
                                </ScrollContainer>
                            </PanelContainer>
                        </BoxContainer>

                    </BoxContainer>

                    <BoxContainer Orientation="Vertical" VerticalExpand="False" Margin="0 0 0 0">
                        <controls:StripeBack HasBottomEdge="False" HasMargins="False" HorizontalExpand="True">
                            <Label Name="OsLabel" HorizontalAlignment="Left" Margin="8 0" StyleClasses="LabelSubText"/>
                        </controls:StripeBack>
                    </BoxContainer>
                </BoxContainer>
            </Control>
        </Control>
    </BoxContainer>
</ui:HydroponicsConsoleWindow>
