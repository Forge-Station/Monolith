<controls:RoadmapWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._WF.Roadmap"
    SetSize="900 800"
    MinSize="600 400"
    Title="{Loc 'wf-roadmap-window-title'}">
    <ScrollContainer>
        <BoxContainer Orientation="Vertical">
            <BoxContainer Orientation="Horizontal">
                <RichTextLabel Name="Header" Margin="0 15 0 10" />
                <Control HorizontalExpand="True" />
                <BoxContainer Orientation="Vertical" Margin="0 0 20 0">
                    <BoxContainer Orientation="Horizontal">
                        <Button Name="DiscordButton" Access="Public" Text="{Loc 'server-info-discord-button'}"
                                Visible="False" StyleClasses="OpenRight" HorizontalExpand="True" />
                        <Button Name="PatreonButton" Access="Public" Text="{Loc 'wf-roadmap-patreon'}"
                                Visible="False" StyleClasses="OpenBoth" HorizontalExpand="True" />
                        <Button Name="CreditsButton" Access="Public" Text="{Loc 'server-info-credits-button'}"
                                StyleClasses="OpenLeft" />
                    </BoxContainer>
                    <Label HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Text="{Loc 'wf-roadmap-not-exhaustive'}" />
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Name="Columns" Access="Public" Orientation="Horizontal" />
        </BoxContainer>
    </ScrollContainer>
</controls:RoadmapWindow>
