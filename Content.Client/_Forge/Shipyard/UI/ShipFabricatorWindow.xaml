<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'ship-fabricator-ui-title'}"
                      MinSize="420 280">
    <BoxContainer Orientation="Vertical" Margin="10">
        <Label Name="VesselLabel" Text="{Loc 'ship-fabricator-ui-no-blueprint'}"/>
        <Label Name="StatusLabel"/>
        <RichTextLabel Name="MaterialsLabel"/>
        <BoxContainer Orientation="Horizontal" Margin="0 8 0 0">
            <Button Name="StartButton" Text="{Loc 'ship-fabricator-ui-start'}"/>
            <Button Name="EjectButton" Text="{Loc 'ship-fabricator-ui-eject'}"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
