ent-WallXeno = xeno chitin wall
    .desc = Hardened alien chitin grown into a solid barrier.
    .suffix = Forge, Xeno, Chitin
ent-WallXenoReinforced = reinforced xeno chitin wall
    .desc = Layers of alien chitin packed until they rival bulkheads.
    .suffix = Forge, Xeno, Chitin, Reinforced
ent-WallXenoResin = resin wall
    .desc = Weird slime solidified into a wall.
    .suffix = Forge, Xeno, CM
ent-WallXenoResinThick = thick resin wall
    .desc = Weird slime packed into a thick, stubborn wall.
    .suffix = Forge, Xeno, CM
ent-WallXenoMembrane = resin membrane
    .desc = Translucent slime that still holds atmosphere.
    .suffix = Forge, Xeno, CM
ent-WallXenoMembraneThick = thick resin membrane
    .desc = Thick slime that is only just translucent enough to let light through.
    .suffix = Forge, Xeno, CM
ent-WallXenoResinIndestructible = { ent-WallXenoResin }
    .desc = { ent-WallXenoResin.desc }
    .suffix = Forge, Xeno, CM, Indestructible

ent-DoorXenoResin = resin door
    .desc = A living resin sphincter. A crowbar forces it open. Xenomorphs pass through.
    .suffix = Forge, Xeno, CM
ent-DoorXenoResinOpen = { ent-DoorXenoResin }
    .desc = { ent-DoorXenoResin.desc }
    .suffix = Forge, Xeno, CM, Open
ent-DoorXenoResinThick = thick resin door
    .desc = A thicker resin sphincter. A crowbar still forces it open. Xenomorphs pass through.
    .suffix = Forge, Xeno, CM
ent-DoorXenoResinThickOpen = { ent-DoorXenoResinThick }
    .desc = { ent-DoorXenoResinThick.desc }
    .suffix = Forge, Xeno, CM, Open

ent-XenoRecoveryTower = xeno recovery tower
    .desc = A pulsing resin spire. Something in the hive uses it to knit wounds.
    .suffix = Forge, Xeno
ent-XenoFrenzyTower = xeno frenzy tower
    .desc = A jagged resin spire. Standing near it feels like a bad idea.
    .suffix = Forge, Xeno
ent-XenoHiveCore = hive core
    .desc = The heart of a xenomorph hive. It should not be here.
    .suffix = Forge, Xeno, CM
ent-XenoEggMorpher = egg morpher
    .desc = A swollen resin organ that grows eggs for the hive.
    .suffix = Forge, Xeno, CM
ent-XenoRecoveryNode = recovery node
    .desc = A resin node that weeps healing plasma.
    .suffix = Forge, Xeno, CM
ent-XenoHivePylon = hive pylon
    .desc = A resin pylon anchoring the hive's presence.
    .suffix = Forge, Xeno, CM
ent-XenoHiveCluster = hive cluster
    .desc = A dense cluster of living resin.
    .suffix = Forge, Xeno, CM
ent-XenoPlasmaCollector = plasma collector
    .desc = A resin organ that gathers plasma from the weeds.
    .suffix = Forge, Xeno, CM
ent-XenoWeeds = hive weeds
    .desc = A carpet of living resin. It sticks to boots and walls alike.
    .suffix = Forge, Xeno, CM
ent-XenoWeedsChoke = thick hive weeds
    .desc = A choking mat of resin. You have to break through it. Xenomorphs slip past.
    .suffix = Forge, Xeno, CM, Corridor
ent-XenoWeedNode = hive weed node
    .desc = A swollen node feeding weeds across the hive.
    .suffix = Forge, Xeno, CM
ent-XenoStickyResin = sticky resin
    .desc = Thick, clinging slime. Moving through it is a struggle.
    .suffix = Forge, Xeno, CM
ent-XenoFastResin = fast resin
    .desc = Slick hive resin. Xenomorphs would love this. You will not.
    .suffix = Forge, Xeno, CM
ent-XenoResinSpikes = resin spikes
    .desc = Jagged resin thorns. Walking onto them is a mistake.
    .suffix = Forge, Xeno, CM
ent-XenoEgg = xenomorph egg
    .desc = A leathery alien egg. Something inside wants out.
    .suffix = Forge, Xeno, CM
ent-XenoEggOpened = opened xenomorph egg
    .desc = The egg has already hatched. The occupant is someone else's problem now.
    .suffix = Forge, Xeno, CM, Opened
ent-XenoTunnel = xenomorph tunnel
    .desc = A hole chewed through resin and deck plating. It does not lead anywhere useful... unless a mapper linked it.
    .suffix = Forge, Xeno, CM

ent-WallNanolaminateSecret = nanolaminate wall
    .desc = A dense wall of strange laminate. It hides a seam — only a linked button will open it.
    .suffix = Forge, Secret, Button
ent-WallNanolaminateSecretOpen = { ent-WallNanolaminateSecret }
    .desc = { ent-WallNanolaminateSecret.desc }
    .suffix = Forge, Secret, Button, Open

ent-BlastDoorAdmin = blast door
    .desc = An indestructible blast door. Device-link ports can only be bound by administrators.
    .suffix = Forge, Admin, Indestructible
ent-BlastDoorAdminOpen = { ent-BlastDoorAdmin }
    .desc = { ent-BlastDoorAdmin.desc }
    .suffix = Forge, Admin, Indestructible, Open

ent-MobForerunnerBorg = remnant cyborg
    .desc = A scavenged precursor chassis running on leftover directives. Weaker than a living tender, still happy to cave a skull in.
    .suffix = Forge, Remnant, AI
ent-MobForerunnerBorgEngineer = remnant engineer cyborg
    .desc = An ancient engineering chassis. Its tools are crude now, but it still knows how to take a wall apart.
    .suffix = Forge, Remnant, AI, Engineer
ent-MobForerunnerBorgAssault = remnant assault cyborg
    .desc = A stripped assault chassis. Its gun still works. Barely.
    .suffix = Forge, Remnant, AI, Assault

ent-MobXenoCMLarva = xenomorph larva
    .desc = A squirming chestburster. Small, fast, and already angry.
    .suffix = Forge, CM, AI
ent-MobXenoCMLesserDrone = xenomorph lesser drone
    .desc = An undersized hive worker. Still has claws, and a little plasma.
    .suffix = Forge, CM, AI
ent-MobXenoCMDrone = xenomorph drone
    .desc = A hive builder. 500 health, a full plasma pool, and the resin kit.
    .suffix = Forge, CM, AI
ent-MobXenoCMRunner = xenomorph runner
    .desc = All legs and teeth. Fast enough to close before you finish aiming.
    .suffix = Forge, CM, AI
ent-MobXenoCMSentinel = xenomorph sentinel
    .desc = A spit caste. Acid, a slowing glob, and a tail.
    .suffix = Forge, CM, AI
ent-MobXenoCMSpitter = xenomorph spitter
    .desc = A meaner spit caste. The acid is worse, and it has more of it.
    .suffix = Forge, CM, AI
ent-MobXenoCMBoiler = xenomorph boiler
    .desc = Bloated artillery. Slow, tough, and full of acid.
    .suffix = Forge, CM, AI
ent-MobXenoCMWarrior = xenomorph warrior
    .desc = A compact killer caste. Punch, lunge, fling.
    .suffix = Forge, CM, AI
ent-MobXenoCMLurker = xenomorph lurker
    .desc = A stalker caste. It hides, then it is on top of you.
    .suffix = Forge, CM, AI
ent-MobXenoCMDefender = xenomorph defender
    .desc = A living shield. Fortify and the crest barely lets damage through.
    .suffix = Forge, CM, AI
ent-MobXenoCMRavager = xenomorph ravager
    .desc = A berserker caste. If it reaches you, the experiment is over.
    .suffix = Forge, CM, AI
ent-MobXenoCMPraetorian = xenomorph praetorian
    .desc = A royal guard. Acid, spit, and a screech that drops a room.
    .suffix = Forge, CM, AI
ent-MobXenoCMCrusher = xenomorph crusher
    .desc = A living battering ram. Charge, then stomp whatever is left.
    .suffix = Forge, CM, AI
ent-MobXenoCMHivelord = xenomorph hivelord
    .desc = A swollen builder. More plasma, thicker resin, and the structures to match.
    .suffix = Forge, CM, AI
ent-MobXenoCMCarrier = xenomorph carrier
    .desc = A walking egg rack. The hive's logistics caste, with claws.
    .suffix = Forge, CM, AI
ent-MobXenoCMBurrower = xenomorph burrower
    .desc = A digging caste. It plants tunnels and weeds, then leaves.
    .suffix = Forge, CM, AI
ent-MobXenoCMQueen = xenomorph queen
    .desc = The hive mother. Screech, acid, construction, and a gutting tail.
    .suffix = Forge, CM, AI

