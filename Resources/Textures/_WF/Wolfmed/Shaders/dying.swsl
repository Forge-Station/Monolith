// Fading-out view for a body close to death: colour drains, the image doubles and swims, the edges close in
// on every heartbeat, and the eyes drift shut now and then.
uniform sampler2D SCREEN_TEXTURE;
uniform highp float level;    // 0 healthy .. 1 at death's door
uniform highp float beat;     // 0..1 heartbeat thump
uniform highp float blackout; // 0..1 eyelids
uniform highp float dead;     // 0..1 the body has died: plain dim greyscale

void fragment() {
    highp vec2 coord = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
    highp float t = TIME;

    // Double vision: two copies drifting apart, wider the worse it gets.
    highp float spread = level * level * 0.007;
    highp vec2 drift = vec2(sin(t * 0.7) + 0.4 * sin(t * 1.9), cos(t * 0.5 + 1.0)) * spread;
    highp vec4 a = zTextureSpec(SCREEN_TEXTURE, coord + drift);
    highp vec4 b = zTextureSpec(SCREEN_TEXTURE, coord - drift);
    highp vec4 tex = mix(a, b, 0.5);

    // Colour drains toward a cold grey.
    highp float grey = dot(tex.rgb, vec3(0.299, 0.587, 0.114));
    highp vec3 cold = vec3(grey * 0.92, grey * 0.97, grey * 1.04);
    highp vec3 colour = mix(tex.rgb, cold, clamp(level * 0.9, 0.0, 0.9));

    // Tunnel: the clear area shrinks with the level and squeezes in on each beat.
    highp float dist = length((coord - vec2(0.5, 0.5)) * vec2(1.0, 0.85));
    highp float inner = mix(0.75, 0.22, level) - beat * 0.05 * level;
    highp float tunnel = smoothstep(inner, inner + 0.45, dist) * clamp(level * 1.3, 0.0, 0.95);
    colour *= 1.0 - tunnel;

    // A faint red flush at the rim on the thump.
    colour.r += beat * level * 0.06 * smoothstep(0.2, 0.7, dist);

    colour *= 1.0 - blackout;

    // Dead: every colour gone, a little dimmer, a soft dark rim.
    highp float deadGrey = dot(colour, vec3(0.299, 0.587, 0.114));
    highp float rim = 1.0 - 0.45 * smoothstep(0.35, 0.85, dist);
    colour = mix(colour, vec3(deadGrey, deadGrey, deadGrey) * 0.82 * rim, dead);
    COLOR = vec4(colour, tex.a);
}
