# M3: organs, brain and core injury, the head blow (plan §8, §3.6).

# The head blow: a faint of a few seconds.
wolfmed-cause-head-blow = a head blow
wolfmed-cause-head-blow-title = Knocked out: head blow
wolfmed-cause-head-blow-symptom = A blow to the head knocked you out.
wolfmed-cause-head-blow-help = You come round in seconds.
wolfmed-cause-head-blow-help-timed = Coming round in { $seconds } s.
wolfmed-cause-head-blow-help-blocked = The blow passes in seconds; something else keeps you under.
wolfmed-cause-head-blow-out = The blow to your head knocks you out.

# Brain injury: Downed until the brain is repaired.
wolfmed-cause-brain = head injury
wolfmed-cause-brain-title = Downed: head injury
wolfmed-cause-brain-symptom = Your thoughts are foggy and your body will not answer.
wolfmed-cause-brain-help = Brain surgery gets you up. Painkillers will not.
wolfmed-cause-brain-help-blocked = Brain surgery, and the rest treated, gets you up.
wolfmed-cause-brain-down = Your head swims and you go down.
wolfmed-cause-brain-wake = You come round, your head swimming.
wolfmed-cause-brain-stand = Your head clears enough to stand.

# Positronic core damage: the chassis is Downed, never shut down by it.
wolfmed-cause-core = core damage
wolfmed-cause-core-title = Downed: core damage
wolfmed-cause-core-symptom = Core integrity critical. Motor control degraded.
wolfmed-cause-core-help = Core repair gets you moving. Welding the frame will not.
wolfmed-cause-core-down = Core integrity critical. Motor control lost.
wolfmed-cause-core-stand = Core integrity restored. Motor control online.
wolfmed-synthetic-cause-core = CORE INTEGRITY CRITICAL: MOBILITY LOST

alerts-wolfmed-faint-head-blow-name = Knocked out: head blow
alerts-wolfmed-faint-head-blow-desc = Knocked out by a blow to the head. Passes in seconds.
alerts-wolfmed-downed-brain-name = Downed: head injury
alerts-wolfmed-downed-brain-desc = Your brain is badly hurt. Brain surgery gets you up; painkillers will not. You can crawl.
alerts-wolfmed-downed-core-name = Downed: core damage
alerts-wolfmed-downed-core-desc = Core integrity critical. Core repair gets you moving.

