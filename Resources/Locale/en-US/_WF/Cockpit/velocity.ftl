wf-cockpit-velocity = VELOCITY
wf-cockpit-velocity-forward = FWD
wf-cockpit-velocity-aft = AFT
wf-cockpit-velocity-port = P
wf-cockpit-velocity-starboard = S
wf-cockpit-velocity-help = Actual ship motion relative to its bow: forward up, aft down, port left, starboard right. The arrow shows drift direction, with extra sensitivity at low speeds. It grows steadily to full length at 100 m/s without changing scale; the readout shows exact speed. A centered dot means stopped. This does not follow the camera.
wf-cockpit-coordinates = COORDINATES
wf-cockpit-coordinates-x = X
wf-cockpit-coordinates-y = Y
wf-cockpit-coordinates-help = Where the ship is on the map, measured at its centre of mass. The SYS page lists the same position.
