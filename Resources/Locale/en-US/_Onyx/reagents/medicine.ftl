# WOLFGATE(Wolfmed): the ten Tier-A keys from ONYX Resources/Locale/en-US/_Onyx/reagents/medicine.ftl (pin 2f5bab9).
# Bodies are Onyx's verbatim; the keys for reagents Wolfgate did not port are omitted.

reagent-name-osteogen = osteogen
reagent-desc-osteogen = A bone-regeneration stimulant. Gradually mends hairline and simple fractures, but does not affect displaced or comminuted fractures.
reagent-name-ibuprofen = ibuprofen
reagent-desc-ibuprofen = A weak drug that helps with headaches and recovery after a bad day.
reagent-name-ketorolac = ketorolac
reagent-desc-ketorolac = A strong, long-lasting non-opioid painkiller for treating injuries without a stimulant effect. High doses worsen bleeding and cause poisoning.
reagent-name-tramadol = tramadol
reagent-desc-tramadol = A powerful combat painkiller. Do not take with alcohol.
reagent-name-oxycodone = oxycodone
reagent-desc-oxycodone = A very powerful painkiller that numbs almost any pain, but causes a brutal overdose. Do not take with alcohol.
