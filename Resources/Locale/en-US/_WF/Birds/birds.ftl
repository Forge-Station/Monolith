# Planet birds (Prototypes/_WF/Birds/birds.yml).

ent-WFMobBirdVerdaSongbird = songbird
    .desc = A small olive-and-yellow bird. They keep to flocks, pecking through the grass and singing until something comes too close.
ent-WFMobBirdAsclepiuGull = lake gull
    .desc = A white gull of Asclepiu's lakes. It wheels over the water a while before it settles.
ent-WFMobBirdGlassSwift = glass-winged swift
    .desc = A sand-coloured desert swift whose wings are clear as glass. Gone at the first footstep.
ent-WFMobBirdSnowGrouse = snow grouse
    .desc = A plump white grouse. It sits tight in the snow until you're almost on top of it.
ent-WFMobBirdAshHawk = ash hawk
    .desc = A charcoal hawk that rides the heat over Fervidus's ash. It stoops on anyone walking alone.
ent-WFMobBirdCarrion = carrion bird
    .desc = A soot-black scavenger. It circles anything that bleeds, then comes down to peck at it.
ent-WFMobBirdFleshKite = flesh kite
    .desc = A featherless thing of the flesh, flapping on wings of raw skin.
