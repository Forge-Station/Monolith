cmd-wolfweather-desc = Sets the weather on a map, with an optional duration in seconds. "clear" stops it.
cmd-wolfweather-help = Usage: wolfweather <mapId> <weather|clear> [seconds]
wolf-weather-command-bad-map = No map with that id.
wolf-weather-command-bad-weather = Unknown weather. Press tab to see the list.
wolf-weather-command-set = Weather set to {$weather}.
wolf-weather-command-bad-seconds = Seconds must be a number above 0 and at most a week (604800).
wolf-weather-command-planet = This is a planet layer: its own weather replaces this at its next change.
wolf-weather-command-not-surface = That map is not a surface: weather falls only on open ground, not on levels below or above it.
wolf-weather-command-hint-map = map id
wolf-weather-command-hint-weather = weather
wolf-weather-command-hint-seconds = seconds (optional)
cmd-wolfweather_schedule-desc = Controls automatic weather on a map. Pick a schedule, "off", "next" to roll a weather now, or "status".
cmd-wolfweather_schedule-help = Usage: wolfweather_schedule <mapId> <schedule|off|next|status>
wolf-weather-schedule-command-bad-schedule = Unknown weather schedule. Press tab to see the list.
wolf-weather-schedule-command-planet = A planet layer follows its own weather. Use the Planet Control panel instead.
wolf-weather-schedule-command-set = Weather schedule set to {$schedule}.
wolf-weather-schedule-command-off = Weather schedule off. Weather it started is cleared.
wolf-weather-schedule-command-rolled = Rolled a new weather.
wolf-weather-schedule-command-not-rolled = No weather could be rolled, so a gap with no weather started.
wolf-weather-schedule-command-none = none
wolf-weather-schedule-command-clear = no weather
wolf-weather-schedule-command-hint = schedule, off, next or status
wolf-weather-schedule-command-status = Schedule {$schedule}, weather {$weather}. Next change in {$seconds} s, then {$next}. Waiting for admin weather to clear: {$waiting}.
wolf-weather-schedule-command-random = a random weather
wolf-weather-schedule-command-yes = yes
wolf-weather-schedule-command-no = no

ui-options-wolf-weather-quality = Weather detail
ui-options-wolf-weather-quality-off = Off
ui-options-wolf-weather-quality-reduced = Reduced
ui-options-wolf-weather-quality-full = Full
