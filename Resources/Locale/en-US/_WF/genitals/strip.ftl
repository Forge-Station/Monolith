# Undergarment removal by other players (SharedUndergarmentStripSystem). Only the actor and the target see the popups.

wf-verb-category-undergarments = Undergarments

wf-undergarment-verb-remove-top = Remove undergarment (top)
wf-undergarment-verb-remove-bottom = Remove undergarment (bottom)
wf-undergarment-verb-replace-top = Put back undergarment (top)
wf-undergarment-verb-replace-bottom = Put back undergarment (bottom)

wf-undergarment-start-user = You start removing { THE($target) }'s undergarment.
wf-undergarment-start-target = { CAPITALIZE(THE($user)) } is removing your undergarment.
wf-undergarment-done-user = You remove { THE($target) }'s undergarment.
wf-undergarment-done-target = { CAPITALIZE(THE($user)) } removed your undergarment.

wf-undergarment-replace-start-user = You start putting back { THE($target) }'s undergarment.
wf-undergarment-replace-start-target = { CAPITALIZE(THE($user)) } is putting back your undergarment.
wf-undergarment-replace-done-user = You put back { THE($target) }'s undergarment.
wf-undergarment-replace-done-target = { CAPITALIZE(THE($user)) } put back your undergarment.

# Shown to the actor only. The consent reason is deliberately generic.
wf-undergarment-fail-covered = Clothing is in the way.
wf-undergarment-fail-consent = You cannot do that right now.
wf-undergarment-fail-cooldown = Wait a moment before trying again.
