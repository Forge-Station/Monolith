genetics-console-phenotype-blind = Pulse blocks, then press Express. The console colors the codons: white — no match, yellow — another uniqueness, green — the prefix is right. The colors clear as soon as a block is pulsed again.
genetics-console-phenotype-locked = The mutation has locked in. Reassemble that combination, then press Deactivate to strip it.
genetics-console-phenotype-unknown = The body changed. Look at the subject — this strand's uniqueness is not in the notes yet.
genetics-console-phenotype-known-idle = A uniqueness from this branch is in the notes. Reassemble it to isolate.
genetics-console-branch-expressed = {$branch}  (expressed)
genetics-console-branch-known = {$branch}  — {$name}
genetics-console-codon-tooltip = Pulse this block. Cycles AA → CC → GG → TT → FF → ET → HE → CG → AT → TA → GA → TC → BD.
genetics-console-codon-tooltip-none = White: no uniqueness uses this codon here. Cycles AA → CC → GG → TT → FF → ET → HE → CG → AT → TA → GA → TC → BD.
genetics-console-codon-tooltip-off = Yellow: this codon belongs to another uniqueness — the start of the strand is wrong.
genetics-console-codon-tooltip-on = Green: the prefix is on track. Cycles AA → CC → GG → TT → FF → ET → HE → CG → AT → TA → GA → TC → BD.
genetics-console-hint-legend = White — no match. Yellow — codon from another uniqueness. Green — prefix on track.
genetics-branch-physical = Physical
genetics-branch-vision = Vision
genetics-branch-metabolism = Metabolism
genetics-branch-neural = Neural
genetics-branch-adaptation = Adaptation
genetics-branch-morphology = Morphology
genetics-examine-mutated = [color=lime]{$name} shows {$count} active genetic mutation(s).[/color]
genetics-console-dna = Unique DNA: {$dna}

