<tabs:WolfgateExtraTab xmlns="https://spacestation14.io"
                       xmlns:tabs="clr-namespace:Content.Client._WF.Options.UI.Tabs"
                       xmlns:ui="clr-namespace:Content.Client.Options.UI"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:s="clr-namespace:Content.Client.Stylesheets">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8" VerticalExpand="True">
                <Label Text="{Loc 'ui-options-general-forknotice'}"
                       FontColorOverride="{x:Static s:StyleNano.ConcerningOrangeFore}"
                       StyleClasses="LabelKeyText"/>
                <Label Text="{Loc 'ui-options-wf-interface'}" StyleClasses="LabelKeyText"/>
                <ui:OptionDropDown Name="DropDownWolfgateStyle" Title="{Loc 'ui-options-wf-ui-style'}" />
                <CheckBox Name="WindowPopoutCheckBox" Text="{Loc 'ui-options-wf-window-popout'}" />
                <CheckBox Name="CockpitAutoEnterCheckBox" Text="{Loc 'ui-options-wf-cockpit-auto-enter'}" />
                <CheckBox Name="DefaultNorthCheckBox" Text="{Loc 'ui-options-wf-default-north'}" />
                <CheckBox Name="ShowNewbieTagCheckBox" Text="{Loc 'wf-newbie-option-show-tag'}" />
                <Label Text="{Loc 'ui-options-wf-effects'}" StyleClasses="LabelKeyText"/>
                <CheckBox Name="HeatHazeCheckBox" Text="{Loc 'ui-options-wf-heat-haze'}" />
                <ui:OptionSlider Name="HeatHazeStrengthSlider" Title="{Loc 'ui-options-wf-heat-haze-strength'}" />
                <CheckBox Name="ShockwaveCheckBox" Text="{Loc 'ui-options-wf-shockwave'}" />
                <ui:OptionSlider Name="ShockwaveStrengthSlider" Title="{Loc 'ui-options-wf-shockwave-strength'}" />
                <Label Text="{Loc 'ui-options-wf-medical'}" StyleClasses="LabelKeyText"/>
                <CheckBox Name="CritHeartbeatCheckBox" Text="{Loc 'ui-options-wf-crit-heartbeat'}" />
                <CheckBox Name="DyingEffectsCheckBox" Text="{Loc 'ui-options-wf-dying-effects'}" />
                <CheckBox Name="SyntheticHudCheckBox" Text="{Loc 'ui-options-wf-synthetic-hud'}" />
                <ui:OptionSlider Name="SyntheticHudScaleSlider" Title="{Loc 'ui-options-wf-synthetic-hud-scale'}" />
                <Label Text="{Loc 'ui-options-wf-audio'}" StyleClasses="LabelKeyText"/>
                <ui:OptionSlider Name="InternetSoundVolumeSlider" Title="{Loc 'ui-options-wf-internet-sound-volume'}" />
                <ui:OptionSlider Name="JukeboxVolumeSlider" Title="{Loc 'ui-options-wf-jukebox-volume'}" />
                <CheckBox Name="SoundtrackMuteCheckBox" Text="{Loc 'ui-options-wf-soundtrack-mute'}" />
                <Label Text="{Loc 'ui-options-general-accessibility'}" StyleClasses="LabelKeyText"/>
                <CheckBox Name="DisableFiltersCheckBox" Text="{Loc 'ui-options-no-filters'}" />
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:WolfgateExtraTab>
