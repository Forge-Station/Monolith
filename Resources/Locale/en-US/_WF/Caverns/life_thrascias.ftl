# The Rime Galleries' cave life.

ent-WFMobCavernRimeBat = rime bat
    .desc = A white bat with no use for eyes in the dark. It flutters about the hollows and keeps out of your way.

ent-WFMobCavernFrostWeaver = frost weaver
    .desc = A blind, pale spider that feels the web for prey. Anything that walks into its hollow gets bitten.

ent-WFMobCavernRimeSlime = ice slime
    .desc = A slime as clear as meltwater ice. Its touch is cold enough to numb the skin.

ent-WFRimeCap = rime cap
    .desc = A pale blue cap with a chill on it. Cook two with water in a big bowl for a warming soup.

ent-WFHearthLichen = hearth lichen
    .desc = A scrap of orange lichen, warm to hold. Eaten, it heats you from the inside.

ent-WFCavernRimeCapPlant = rime cap
    .desc = A pale blue mushroom that grows in the drift hollows. Pick it and cook it.

ent-WFCavernHearthLichenPlant = hearth lichen
    .desc = Orange lichen that keeps a little warmth in the cold rock. Cut it with a knife and it grows back.

ent-WFCavernHangingIcicle = hanging icicle
    .desc = A long spike of ice hangs over the way. It creaks when anyone walks under it.

ent-WFCavernFrostBulb = frost bulb
    .desc = A swollen bulb, white with rime. Come too close and it bursts into a cloud of freezing mist.

ent-WFCavernPlasmaBloom = plasma bloom
    .desc = A bruise-coloured bulb that has drunk too deep from the lake. It vents plasma at anything that touches it.

wf-cavern-icicle-creaks = The icicle above you creaks!
wf-cavern-icicle-falls = The icicle falls in a shower of shards!
wf-cavern-plasma-bloom-vents = The bloom vents a cloud of plasma!
