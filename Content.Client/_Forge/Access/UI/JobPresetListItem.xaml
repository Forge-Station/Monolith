<Button xmlns="https://spacestation14.io"
        xmlns:controls="clr-namespace:Robust.Client.UserInterface.Controls;assembly=Robust.Client"
        Access="Public"
        ToggleMode="True"
        HorizontalExpand="True"
        MinSize="0 60">
    <BoxContainer Orientation="Horizontal" SeparationOverride="10" Margin="10 6">
        <PanelContainer StyleClasses="Inset"
                        MinSize="28 28"
                        MaxSize="28 28"
                        Margin="0 2 0 0">
            <TextureRect Name="JobIcon"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stretch="KeepCentered"
                         TextureScale="2 2"
                         SetSize="16 16" />
        </PanelContainer>
        <BoxContainer Orientation="Vertical"
                      SeparationOverride="2"
                      VerticalAlignment="Center"
                      HorizontalExpand="True">
            <Label Name="JobTitle"
                   HorizontalExpand="True"
                   ClipText="True" />
            <controls:RichTextLabel Name="JobSubtitle"
                                    StyleClasses="LabelSubText"
                                    HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</Button>
