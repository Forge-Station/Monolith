ent-AncientBattery = древняя батарея
    .desc = Герметичный элемент питания предтеч. Современные устройства его отвергают, но ЛКП руин всё ещё принимают эту форму.
    .suffix = Forge, Предтеч

ent-APCRemnantEmpty = предтечевый ЛКП
    .desc = Контроллер питания зоны предтеч. Не будет питать локальную сеть, пока в скважину не вставят древнюю батарею.
    .suffix = Forge, Предтеч, Пустой
ent-APCRemnant = { ent-APCRemnantEmpty }
    .desc = { ent-APCRemnantEmpty.desc }
    .suffix = Forge, Предтеч, С батареей

ent-RemnantHatch = люк предтеч
    .desc = Герметичный люк. Парный люк на другом Z-уровне соединяется автоматически. Можно пройти по нему или взаимодействовать.
    .suffix = Forge, Предтеч, Z-уровень
ent-RemnantHatchAlpha = { ent-RemnantHatch }
    .desc = { ent-RemnantHatch.desc }
    .suffix = Forge, Предтеч, Z-уровень, Альфа
ent-RemnantHatchBeta = { ent-RemnantHatch }
    .desc = { ent-RemnantHatch.desc }
    .suffix = Forge, Предтеч, Z-уровень, Бета

ent-RemnantLadder = лестница предтеч
    .desc = Лестница предтеч. Взаимодействуйте с парной лестницей, чтобы подняться на другой Z-уровень.
    .suffix = Forge, Предтеч, Z-уровень
ent-RemnantLadderAlpha = { ent-RemnantLadder }
    .desc = { ent-RemnantLadder.desc }
    .suffix = Forge, Предтеч, Z-уровень, Альфа
ent-RemnantLadderBeta = { ent-RemnantLadder }
    .desc = { ent-RemnantLadder.desc }
    .suffix = Forge, Предтеч, Z-уровень, Бета
ent-RemnantZLevelLadder = лестница предтеч (Z-уровень)
    .desc = Лестница для высот CE z-level. Ставьте на стеках карт z-сети.
    .suffix = Forge, Предтеч, CE Z-Level

ent-RemnantPressurePlate = нажимная плита предтеч
    .desc = Наступив, посылает импульс по device-link. Связывается мультитулом.
    .suffix = Forge, Предтеч
ent-RemnantPressurePlateInvisible = нажимная плита предтеч
    .desc = Почти невидимая плита. Наступив, всё равно посылает импульс.
    .suffix = Forge, Предтеч, Невидимая
ent-RemnantMotionSensor = датчик движения предтеч
    .desc = Настенный датчик. Движение рядом даёт импульс device-link.
    .suffix = Forge, Предтеч

ent-RemnantCombinationLock = кодовый замок предтеч
    .desc = Клавиатура предтеч. Код задаётся полем Code при маппинге (по умолчанию 1234). Верный ввод пульсирует связанные устройства.
    .suffix = Forge, Предтеч
ent-RemnantCombinationLock0000 = { ent-RemnantCombinationLock }
    .desc = { ent-RemnantCombinationLock.desc }
    .suffix = Forge, Предтеч, 0000
ent-RemnantCombinationLock7319 = { ent-RemnantCombinationLock }
    .desc = { ent-RemnantCombinationLock.desc }
    .suffix = Forge, Предтеч, 7319

ent-RemnantKeycard = ключ-карта предтеч
    .desc = Токен доступа предтеч. Открывает шлюзы, люки и доки руин.
    .suffix = Forge, Предтеч

ent-RemnantMultitoolConsole = сигнальная консоль предтеч
    .desc = Консоль с переименовываемыми кнопками. Мультитул показывает сохранённый текст. Подписи и Message задаются при маппинге.
    .suffix = Forge, Предтеч

ent-RemnantInscription = надпись предтеч
    .desc = Письмена предтеч. Без знания языка видны только искажённые знаки. Text и Language задаются при маппинге.
    .suffix = Forge, Предтеч
ent-RemnantInscriptionBlank = { ent-RemnantInscription }
    .desc = { ent-RemnantInscription.desc }
    .suffix = Forge, Предтеч, Пустая
ent-RemnantInscriptionWarning = предупреждающая надпись предтеч
    .desc = { ent-RemnantInscription.desc }
    .suffix = Forge, Предтеч, Предупреждение
ent-RemnantInscriptionSecure = охранная надпись предтеч
    .desc = { ent-RemnantInscription.desc }
    .suffix = Forge, Предтеч, Охрана
ent-RemnantInscriptionVault = надпись хранилища предтеч
    .desc = { ent-RemnantInscription.desc }
    .suffix = Forge, Предтеч, Хранилище

ent-LockableButtonRemnant = { ent-LockableButton }
    .desc = { ent-LockableButton.desc }
    .suffix = Forge, Предтеч

ent-PaperRemnant = пергамент предтеч
    .desc = Хрупкая бумага предтеч. Без знания языка текст не прочитать.
    .suffix = Forge, Предтеч, Драконий, Пустой
ent-PaperRemnantWritten = { ent-PaperRemnant }
    .desc = { ent-PaperRemnant.desc }
    .suffix = Forge, Предтеч, Драконий, С текстом
ent-PaperRemnantWarning = { ent-PaperRemnant }
    .desc = { ent-PaperRemnant.desc }
    .suffix = Forge, Предтеч, Драконий, Предупреждение
ent-PaperRemnantSecure = { ent-PaperRemnant }
    .desc = { ent-PaperRemnant.desc }
    .suffix = Forge, Предтеч, Драконий, Охрана
ent-PaperRemnantVault = { ent-PaperRemnant }
    .desc = { ent-PaperRemnant.desc }
    .suffix = Forge, Предтеч, Драконий, Хранилище
