<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'wf-orbit-unsanctioned-title'}"
                      MinSize="420 170"
                      SetSize="420 170">
    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
        <RichTextLabel Name="WarningLabel" MaxWidth="396" HorizontalExpand="True" VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalAlignment="Right">
            <Button Name="ProceedButton" Text="{Loc 'wf-orbit-unsanctioned-proceed'}" StyleClasses="ButtonCaution" />
            <Button Name="AbortButton" Text="{Loc 'wf-orbit-unsanctioned-abort'}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
