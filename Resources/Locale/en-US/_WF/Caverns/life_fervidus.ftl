# The Cinder Vaults' cave life (Prototypes/_WF/Caverns/Life/fervidus.yml).

wf-recipe-cinder-cap-soup = cinder cap soup recipe
wf-cave-firepod-swells = The fire pod swells and glows white-hot!
wf-cave-firepod-bursts = The fire pod bursts in a flash of heat!
wf-cave-ventpuff-puff = The vent cap coughs out a yellow cloud!

ent-WFCinderCapMushroom = cinder cap
    .desc = A warm, orange-capped shelf fungus. Cook two in a big bowl with water for a soup; raw, it has a bite.
ent-WFFoodSoupCinderCap = cinder cap soup
    .desc = A peppery soup of cinder caps.
ent-WFCaveSulphurCrust = sulphur crust
    .desc = A yellow crust scraped from a sulphur bloom. Grind it for sulphur.

ent-WFCaveHeatShelf = cinder shelf
    .desc = A shelf fungus that feeds on the heat of the glass. Pick the caps; they grow back.
ent-WFCaveFirePod = fire pod
    .desc = A pod glowing orange from within. It swells when someone stands near and bursts in a flash of heat; it grows back. Shoot it from afar.
ent-WFCaveSulphurBloom = sulphur bloom
    .desc = A yellow flower that grows on the crust round the vents. Scrape its petals for sulphur; it grows back.
ent-WFCaveVentPuff = vent cap
    .desc = A grey cap crusted yellow. It coughs a poisonous cloud at anyone who comes close.

ent-WFMobCinderSpider = cinder spider
    .desc = A black spider with a glowing, cracked back, at home on the volcanic glass. The heat doesn't trouble it.
ent-WFMobEmberViper = ember viper
    .desc = A black cobra with embers in its hood, curled up on the warm ledges.
ent-WFMobSlagTick = slag tick
    .desc = A tick the colour of cooled slag. It lives on the sulphur crust and bites whatever walks over it.
ent-WFMobSulphurCarp = sulphur carp
    .desc = A yellow carp that swims the hot air over the vents as if it were water.
