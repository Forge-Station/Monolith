<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'station-radio-frequency-listen-title'}"
                      MinSize="260 250"
                      SetSize="260 250">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="5 0 5 0">
        <Control MinHeight="8"/>
        <BoxContainer Orientation="Vertical" SeparationOverride="4" MinWidth="220">
            <Label Name="ModeLabel" Text="{Loc 'station-radio-frequency-listen-label'}" />
            <Label Text="{Loc 'handheld-radio-popular-label'}" />
            <OptionButton Name="PopularFrequencyOptions" HorizontalExpand="True" />
            <Label Text="{Loc 'handheld-radio-custom-label'}" />
            <LineEdit Name="FrequencyLineEdit" />
            <Button Name="ReceiverToggle"
                    ToggleMode="True"
                    Text="{Loc 'station-radio-frequency-receiver-on'}"
                    Visible="False"/>
        </BoxContainer>
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
                <Label Text="{Loc 'handheld-radio-flavor-text-left'}" StyleClasses="WindowFooterText"
                       HorizontalAlignment="Left" HorizontalExpand="True" Margin="0 0 5 0" />
                <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                             VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
