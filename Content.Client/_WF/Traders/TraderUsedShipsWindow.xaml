<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      MinSize="640 400"
                      SetSize="700 480"
                      Title="{Loc 'trader-used-window-title'}">
    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="6">
        <PanelContainer StyleClasses="AngleRect"
                        VerticalExpand="True"
                        HorizontalExpand="True"
                        ModulateSelfOverride="#0A0A0A">
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="5">
                <BoxContainer Name="LotBox"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              SeparationOverride="4"/>
            </ScrollContainer>
        </PanelContainer>

        <!-- What the salesman can see in front of them -->
        <Label Name="ZoneLabel" StyleClasses="LabelSecondaryColor"/>
        <Label Name="BalanceLabel" StyleClasses="LabelSecondaryColor"/>
    </BoxContainer>
</controls:FancyWindow>
