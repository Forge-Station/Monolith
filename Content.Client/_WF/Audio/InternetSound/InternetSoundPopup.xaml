<!-- Names must avoid DefaultWindow's own: CloseButton, ContentsContainer, TitleLabel, WindowHeader. -->
<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'wf-internet-sound-popup-title'}"
               MinSize="280 0">
    <BoxContainer Orientation="Vertical" Margin="6 2">
        <Label Name="SoundLabel"
               StyleClasses="LabelKeyText"
               ClipText="True"
               HorizontalExpand="True" />
        <Label Name="StatusLabel"
               StyleClasses="LabelSubText"
               ClipText="True"
               HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
            <Slider Name="VolumeSlider"
                    MinValue="0"
                    MaxValue="100"
                    HorizontalExpand="True"
                    VerticalAlignment="Center" />
            <Label Name="VolumeLabel"
                   StyleClasses="LabelSubText"
                   MinWidth="36"
                   Align="Right"
                   VerticalAlignment="Center"
                   Margin="4 0" />
            <Button Name="StopButton"
                    Text="{Loc 'wf-internet-sound-popup-stop'}"
                    StyleClasses="ButtonSquare" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
