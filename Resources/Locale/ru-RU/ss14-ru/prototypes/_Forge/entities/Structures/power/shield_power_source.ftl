ent-ShieldPowerSourceBase = источник питания щита
    .desc = Выделенный конденсаторный банк для эмиттеров щита. Не подключён к ЛКП шаттла.
ent-ShieldPowerSourceT1 = ИПС-90 "Искра" источник питания щита
    .desc = Компактный конденсаторный банк для лёгких судов. Питает эмиттеры щита на том же гриде без ЛКП.
    .suffix = тир 1
ent-ShieldPowerSourceT2 = ИПС-180 "Киль" источник питания щита
    .desc = Средний конденсаторный банк для фрегатных эмиттеров.
    .suffix = тир 2
ent-ShieldPowerSourceT3 = ИПС-360 "Массив" источник питания щита
    .desc = Тяжёлый конденсаторный банк для крейсерских эмиттеров и длительного боя.
    .suffix = тир 3
ent-ShieldPowerSourceT4 = ИПС-870 "Наковальня" источник питания щита
    .desc = Капитальный конденсаторный банк с большим запасом разряда под тир-4 эмиттеры.
    .suffix = тир 4
ent-MachineShieldPowerSourceT1Circuitboard = плата ИПС-90
    .desc = Машинная печатная плата источника питания щита тир 1.
ent-MachineShieldPowerSourceT2Circuitboard = плата ИПС-180
    .desc = Машинная печатная плата источника питания щита тир 2.
ent-MachineShieldPowerSourceT3Circuitboard = плата ИПС-360
    .desc = Машинная печатная плата источника питания щита тир 3.
ent-MachineShieldPowerSourceT4Circuitboard = плата ИПС-870
    .desc = Машинная печатная плата источника питания щита тир 4.
