ent-BaseMobForgeLeviathan = leviathan
    .desc = Something that should not share a sector with ships.
ent-MobForgeVoidDrake = void drake
    .desc = An astral leviathan of horned wings and starfire. Not a carp dragon — a hunger that learned to fly between stars.
ent-MobForgeVoidDrakeAI = void drake
    .suffix = AI, Forge
    .desc = { ent-MobForgeVoidDrake.desc }
ent-MobForgeVoidWorm = void worm
    .desc = A colossal cosmic worm six tiles thick and a cruiser long. Its maw is a tunnel, its body a living corridor of teeth.
ent-MobForgeVoidWormAI = void worm
    .suffix = AI, Forge
    .desc = { ent-MobForgeVoidWorm.desc }
ent-MobForgeVoidWormling = void wormling
    .desc = A freshly torn brood-spawn of a void worm. Small only by leviathan standards.
    .suffix = Forge
ent-MobForgeVoidWormSegment = void worm segment
    .desc = A living ring of armor and teeth.
ent-MobForgeVoidWormSegmentAlt = void worm segment
    .desc = { ent-MobForgeVoidWormSegment.desc }
ent-MobForgeVoidWormTail = void worm tail
    .desc = The last ring of the colossus, tapering into the void.
ent-FoodMeatForgeLeviathan = leviathan flesh
    .desc = Dense meat veined with starlight ichor. Eating it feels like swallowing a small gravity well.
ent-ActionForgeVoidDrakeStarfire = [color=#c44dff]Starfire Breath[/color]
    .desc = Exhale a shard of a dying star. Melts hulls and cooks anyone in the way.
ent-ActionForgeVoidDrakeGravityWell = [color=#9B4DFF]Gravity Well[/color]
    .desc = Collapse nearby mass toward your maw. Ships, crew, debris — all fall in.
ent-ActionForgeVoidDrakeWingTempest = [color=#9ad8ff]Wing Tempest[/color]
    .desc = Beat your wings and hurl everything nearby into the void.
ent-ActionForgeVoidDrakeSolarFlare = [color=#ffd24a]Solar Flare[/color]
    .desc = Ignite like a miniature sun. Blind, scorch, and EMP everything around you.
ent-ActionForgeVoidWormAcid = [color=#5DFFC8]Acid Spittle[/color]
    .desc = Spit a glob of cosmic acid that eats flesh and plating alike.
ent-ActionForgeVoidWormWarpBreach = [color=#7dffcc]Warp Breach[/color]
    .desc = Tear a hole in space and reappear at the target, detonating the tunnel behind you.
ent-ActionForgeVoidWormCoilSmash = [color=#c8f5e0]Coil Smash[/color]
    .desc = Contract your entire bulk and crush everything caught in the coil.
ent-ActionForgeVoidWormBroodBurst = [color=#9bffc8]Brood Burst[/color]
    .desc = Tear off living segments that hunt as wormlings.
ent-MobForgeVoidMedusa = void medusa
    .desc = A hanging lantern of living vacuum. Tentacles drink thrust from ships; the bell blooms ion fire. It does not chew hulls — it steals them.
ent-MobForgeVoidMedusaAI = void medusa
    .suffix = AI, Forge
    .desc = { ent-MobForgeVoidMedusa.desc }
ent-MobForgeVoidMedusaPolyp = void polyp
    .desc = A torn fragment of the medusa's bell. It wants a hull to cling to, then a fuse to die on.
    .suffix = Forge
ent-SpawnMobForgeVoidMedusa = void medusa spawner
    .suffix = AI, Forge
    .desc = { ent-MarkerBase.desc }
ent-SpawnMobForgeVoidMedusaAI = void medusa AI spawner
    .suffix = AI, Forge
    .desc = { ent-MarkerBase.desc }
ent-ForgeVoidMedusaIonGun = medusa ion organ
    .desc = Spits a harpoon of living lightning.
ent-ProjectileForgeVoidMedusaIon = ion harpoon
    .desc = A living bolt that kills electronics, not plating.
ent-ActionForgeVoidMedusaIonHarpoon = [color=#88a0ff]Ion Harpoon[/color]
    .desc = Spear a shuttle with living lightning. EMP on impact — hulls stay, systems die.
ent-ActionForgeVoidMedusaLatch = [color=#c9a0ff]Tentacle Latch[/color]
    .desc = Grapple a shuttle and drag it toward the bell. The ship comes to you.
ent-ActionForgeVoidMedusaIonBloom = [color=#7a5cff]Ion Bloom[/color]
    .desc = The bell detonates an EMP flower. Consoles, guns, thrusters — all go dark.
ent-ActionForgeVoidMedusaStasisVeil = [color=#a8e4ff]Stasis Veil[/color]
    .desc = Freeze nearby crew and damp a latched shuttle so it cannot thrust away.
ent-ActionForgeVoidMedusaPolypRain = [color=#6ec8ff]Polyp Rain[/color]
    .desc = Shed shock-jellies that hunt hulls and EMP when they die.
