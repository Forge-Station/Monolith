<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:ui="clr-namespace:Content.Client._Forge.Turrets"
                      Title="{Loc 'turret-command-window-title'}"
                      Resizable="True"
                      SetSize="1200 820"
                      MinSize="960 680">
    <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True" HorizontalExpand="True">
        <Label Name="NoServerLabel" Text="{Loc 'turret-command-window-no-server'}" Visible="False"/>

        <TabContainer Name="Tabs" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="4" VerticalExpand="True" HorizontalExpand="True">
                <Label Name="MapHint" Text="{Loc 'turret-command-window-map-hint'}" Margin="0 0 0 4"/>
                <PanelContainer Name="MapPanel" VerticalExpand="True" HorizontalExpand="True">
                    <ui:TurretNavMapControl Name="NavMap" Margin="4" HorizontalExpand="True" VerticalExpand="True"/>
                </PanelContainer>
            </BoxContainer>

            <BoxContainer Orientation="Vertical" Margin="4" VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0 0 0 8">
                    <Button Name="NeutralButton" Text="{Loc 'turret-command-mode-neutral'}" HorizontalExpand="True" TextAlign="Center"/>
                    <Button Name="HostileModeButton" Text="{Loc 'turret-command-mode-hostile'}" HorizontalExpand="True" TextAlign="Center"/>
                    <Button Name="FriendlyModeButton" Text="{Loc 'turret-command-mode-friendly'}" HorizontalExpand="True" TextAlign="Center"/>
                </BoxContainer>
                <Label Name="AllHint" Text="{Loc 'turret-command-mode-all-hint'}" Margin="0 0 0 2"/>
                <Label Name="ModeHint" Margin="0 0 0 6"/>
                <PanelContainer Name="TurretPanel" VerticalExpand="True" HorizontalExpand="True">
                    <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="6">
                        <BoxContainer Name="TurretList" Orientation="Vertical" HorizontalExpand="True"/>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>

            <BoxContainer Orientation="Vertical" Margin="4" VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
                    <Label Name="PresentHeading" Text="{Loc 'turret-command-window-present'}" HorizontalExpand="True" VerticalAlignment="Center"/>
                    <Button Name="RefreshButton" Text="{Loc 'turret-command-window-refresh'}" MinWidth="120"/>
                </BoxContainer>
                <PanelContainer Name="PresentPanel" SetHeight="150" Margin="0 0 0 8">
                    <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="6">
                        <BoxContainer Name="PresentList" Orientation="Vertical" HorizontalExpand="True"/>
                    </ScrollContainer>
                </PanelContainer>
                <PanelContainer Name="AddPanel" Margin="0 0 0 8">
                    <BoxContainer Orientation="Horizontal" Margin="8" SeparationOverride="6">
                        <LineEdit Name="NameInput"
                                  PlaceHolder="{Loc 'turret-command-window-name-placeholder'}"
                                  HorizontalExpand="True"/>
                        <Button Name="FriendlyButton" Text="{Loc 'turret-command-window-mark-friendly'}" MinWidth="88"/>
                        <Button Name="HostileButton" Text="{Loc 'turret-command-window-mark-hostile'}" MinWidth="88"/>
                    </BoxContainer>
                </PanelContainer>
                <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="8">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <Label Name="FriendlyHeading" Text="{Loc 'turret-command-window-friendly'}" Margin="0 0 0 4"/>
                        <PanelContainer Name="FriendlyPanel" VerticalExpand="True">
                            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="6">
                                <BoxContainer Name="FriendlyList" Orientation="Vertical" HorizontalExpand="True"/>
                            </ScrollContainer>
                        </PanelContainer>
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <Label Name="HostileHeading" Text="{Loc 'turret-command-window-hostile'}" Margin="0 0 0 4"/>
                        <PanelContainer Name="HostilePanel" VerticalExpand="True">
                            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="6">
                                <BoxContainer Name="HostileList" Orientation="Vertical" HorizontalExpand="True"/>
                            </ScrollContainer>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </TabContainer>
    </BoxContainer>
</controls:FancyWindow>
