ent-WFHeavyVehicleLicence = heavy vehicle licence
    .desc = Lets the holder buy and run armoured vehicles and their weapons. Keep it on you at the outfitter.
wf-heavy-licence-name = heavy vehicle licence ({ $holder })
wf-heavy-licence-examine-holder = Issued to [color=white]{ $holder }[/color].
wf-heavy-licence-examine-blank = The holder's name is blank.

wf-military-hardpoint-civilian = { CAPITALIZE(THE($vehicle)) } is a civilian vehicle. Weapons and turrets only go on a military chassis.

ent-WFComputerMilitaryOutfitter = military outfitter terminal
    .desc = Sells military vehicle chassis, delivered to the pad nearby, and their hardpoints. Most of it needs a heavy vehicle licence. Park a vehicle on the pad to sell it back.
ent-WFComputerMilitaryCounter = military outfitter counter
    .desc = Sells heavy vehicle licences and vehicle hardpoints, armour and ammunition. Weapons need a licence.

ent-WFMilitaryChassisTank = tank (chassis)
    .desc = A tank with treads, ballistic plating and an empty turret. Guns sold separately.
ent-WFMilitaryChassisTankPMC = M34A2 Longstreet 'Yutani' (chassis)
    .desc = A Yutani light tank with treads, ballistic plating and an empty turret. Guns sold separately.
ent-WFMilitaryChassisHumvee = humvee (chassis)
    .desc = A military humvee with an empty turret ring. Turret and guns sold separately.
